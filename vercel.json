{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/app/**,data/**,projects/raw/**,frontend/dist/**}",
      "maxDuration": 60
    }
  }
}
