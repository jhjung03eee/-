# Elice Cloud API 설정 (LLM 사용 시 필요)
# 발급받은 API 키를 여기에 입력하세요
OPENAI_API_KEY=your_elice_api_key_here

# Elice API 엔드포인트 (반드시 /v1 경로 필요)
OPENAI_BASE_URL=https://mlapi.run/286e9158-d32e-436d-a23d-36b43fc8e68a/v1

# 모델 설정 (제공된 모델 ID)
# NOTE: gpt-5.6-luna는 temperature 기본값(1)만 지원, 별도 설정 비활성화
OPENAI_MODEL=openai/gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

# 선택적 설정
# LLM_TIMEOUT_SECONDS=90
# LLM_TEMPERATURE=1
# MIN_PROJECT_BUDGET=1000000000
# STRONG_THRESHOLD=0.75
# REVIEW_THRESHOLD=0.50